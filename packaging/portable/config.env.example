# Configuracao do 3E Operacoes (pacote portatil).
# Copie este arquivo para "config.env" e preencha os valores.

# Banco de dados MySQL do aplicativo (ja migrado/populado)
DATABASE_URL="mysql://usuario:senha@host:3306/3e_operacoes"

# Segredo da sessao (string longa e aleatoria)
SESSION_SECRET="troque-por-um-segredo-forte"

# Integracao com o conector local (Top Gerente)
APP_INTERNAL_TOKEN="troque"
LOCAL_CONNECTOR_BASE_URL="http://localhost:8787"
LOCAL_CONNECTOR_TOKEN="troque"
CONNECTOR_CALLBACK_TOKEN="troque"
CONNECTOR_TIMEOUT_MS="20000"

# Fuso horario e porta
APP_TIMEZONE="America/Sao_Paulo"
PORT="3000"
