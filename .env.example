# Banco próprio do aplicativo no Railway
DATABASE_URL="mysql://usuario:senha@host:3306/3e_operacoes"

# Token interno temporário das rotas de usuário /api/integracao (até a feature de autenticação).
APP_INTERNAL_TOKEN="trocar-em-producao"

# Segredo para assinar o cookie de sessão (auth). Gere um valor aleatório forte.
SESSION_SECRET="trocar-em-producao"

# URL pública do conector local exposto por Cloudflare Tunnel/Access.
LOCAL_CONNECTOR_BASE_URL="https://connector.exemplo.com"
LOCAL_CONNECTOR_TOKEN="trocar-em-producao"

# Token que o conector local usa no callback (POST /api/integracao/callback).
# Deve ter o mesmo valor do CONNECTOR_CALLBACK_TOKEN configurado no conector.
CONNECTOR_CALLBACK_TOKEN="trocar-em-producao"

# Não colocar credenciais do Top Gerente neste arquivo do Railway.
APP_TIMEZONE="America/Sao_Paulo"
